DATABASE_URL=mongodb://127.0.0.1/your-database-name
PAYLOAD_SECRET=YOUR_SECRET_HERE
PAYLOAD_PUBLIC_SERVER_URL=https://dev.moreu.ai
PAYLOAD_MEDIA_DIR=/app/media
# Production must use either a persistent volume mounted at PAYLOAD_MEDIA_DIR,
# or S3-compatible object storage. R2_* aliases are also supported.
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=us-east-1
S3_ENDPOINT=
S3_PUBLIC_URL=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
R2_PUBLIC_URL=
DAILY_REPORT_SHARED_SECRET=OPTIONAL_INTERNAL_SHARED_SECRET
CRYPTO_NEWS_SOURCE_URL=https://www.blocktempo.com/feed/
CTEE_NEWSPAPER_URL=https://newspaper.ctee.com.tw/
ECONOMIC_DAILY_IMAGE_URL_TEMPLATE=https://un.udndata.com/publicPlay/ED/ED{yyyy}/{mm}/{dd}/{page}_{pageSerial}.JPG
ECONOMIC_DAILY_PAGE_CODES=A01,A02,A03
ECONOMIC_DAILY_USERNAME=
ECONOMIC_DAILY_PASSWORD=
ECONOMIC_DAILY_URL=https://ers.nlpi.edu.tw/sendURLApiV3?dbid=10S204100&mode=click
# Optional fallback when the same NLPI account is shared across databases.
NLPI_LIBRARY_USERNAME=
NLPI_LIBRARY_PASSWORD=
CTEE_CHINA_URL=https://www.ctee.com.tw/china
CTEE_WORLD_URL=https://www.ctee.com.tw/world
CTEE_DIGEST_ITEMS_PER_SECTION=3
US_STOCK_HEATMAP_URL=https://finviz.com/map?t=sec
US_STOCK_HEATMAP_MODE=auto
DAILY_REPORT_PACKAGE_URL=http://localhost:3000/api/daily-report/package
DAILY_REPORT_MARK_SENT_URL=http://localhost:3000/api/daily-report/mark-sent
DAILY_REPORT_GENERATE=missing
LINE_APP_NAME=LINE
LINE_RELAY_TARGET=V1 LINE OpenChat
LINE_RELAY_OPERATOR=macOS relay
LINE_RELAY_DELAY_MS=1400
LINE_RELAY_PASTE_DELAY_MS=800
LINE_RELAY_FOCUS_DELAY_MS=5000
LINE_RELAY_PASTE_METHOD=keycode
LINE_RELAY_SEND_KEY=enter
LINE_RELAY_MARK_SENT=true
LINE_RELAY_KEEP_FILES=false
LINE_RELAY_ALLOW_RESEND=false
LINE_RELAY_AUTO=true
LINE_RELAY_ROOM_NAME=
LINE_RELAY_SEARCH_MODE=keyboard
LINE_RELAY_SEARCH_SHORTCUT=cmd-shift-f
LINE_RELAY_SEARCH_TAB_COUNT=0
LINE_RELAY_SEARCH_DELAY_MS=1200
LINE_RELAY_SEARCH_BOX_CLICK=
LINE_RELAY_SEARCH_RESULT_CLICK=
LINE_RELAY_SEARCH_RESULT_MODE=keyboard
LINE_RELAY_SEARCH_OPEN_KEY=down-enter
LINE_RELAY_SEARCH_RESULT_OFFSET=132
LINE_RELAY_SEARCH_RESULT_LAYOUT=100,169
LINE_RELAY_SEARCH_RESULT_RATIO=0.22,0.2
LINE_RELAY_SEARCH_RESULT_STEPS=2
LINE_RELAY_WINDOW_BOUNDS=0,0,1200,900
LINE_RELAY_ROOM_CLICK=
LINE_RELAY_INPUT_CLICK=
LINE_RELAY_CLICK_DELAY_MS=800
LINE_RELAY_MOUSE_POSITION_DELAY_MS=0
LINE_RELAY_SMART_ROOM=false
LINE_RELAY_SMART_ROOM_STEPS=2,1,3,0,4
LINE_RELAY_VERIFY_BEFORE_SEND=false
LINE_RELAY_VERIFY_DELAY_MS=1800
LINE_RELAY_VERIFY_THRESHOLD=0.85
LINE_RELAY_VISION_PROVIDER=openrouter
LINE_RELAY_VISION_MODEL=openai/gpt-4.1-mini
# One-click daily report orchestration. The LLM planner only chooses which
# deterministically failed parts to retry; artifact validation remains code-owned.
DAILY_REPORT_LLM_RECOVERY=1
DAILY_REPORT_REPAIR_CYCLES=1
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4.1-mini
OPENROUTER_APP_NAME=daily-report-recovery
